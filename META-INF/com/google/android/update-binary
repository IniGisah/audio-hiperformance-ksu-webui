#!/sbin/sh

#################
# Initialization
#################

umask 022

ui_print() { echo "$1"; }

require_ksu_env() {
  ui_print "****************************************"
  ui_print " KernelSU / APatch environment required "
  ui_print "****************************************"
  exit 1
}

#########################
# Load util_functions.sh
#########################

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

if [ -f /data/adb/ksu/util_functions.sh ]; then
  . /data/adb/ksu/util_functions.sh
elif [ -f /data/adb/ap/util_functions.sh ]; then
  . /data/adb/ap/util_functions.sh
elif [ -f /data/adb/util_functions.sh ]; then
  . /data/adb/util_functions.sh
elif [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
else
  require_ksu_env
fi

install_module
exit 0

